{
  "name": "@omnimedia/kimura",
  "version": "1.0.5-11",
  "description": "A tool for interactively editing the transformation matrices of pixi objects.",
  "type": "module",
  "main": "x/index.js",
  "scripts": {
    "build": "run-s _clean _tsc _ln _scute",
    "start": "octo 'scute -vw' 'tsc -w' 'node --watch x/tests.test.js' 'http-server x'",
    "_clean": "rm -rf x && mkdir x",
    "_tsc": "tsc",
    "_ln": "run-s _ln-s _ln-assets",
    "_ln-s": "ln -s \"$(realpath s)\" x/s",
    "_ln-assets": "ln -s \"$(realpath assets)\" x/assets",
    "_scute": "scute -v",
    "test": "echo \"node tests disabled for now\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SukantPal/pixi-essentials.git"
  },
  "keywords": [
    "pixijs",
    "transfomer",
    "konva-transformer"
  ],
  "author": "Przemysław Gałęzki",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/omni-media/kimura/issues"
  },
  "homepage": "https://github.com/omni-media/kimura#readme",
  "files": [
    "x",
    "s"
  ],
  "dependencies": {
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5"
  },
  "peerDependencies": {
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "@e280/scute": "^0.5.3",
    "@e280/octo": "^0.1.7",
    "pixi.js": "^8.22.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  }
}
